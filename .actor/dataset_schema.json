{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "domain": {
        "type": "string",
        "title": "Domain",
        "description": "Root domain that was scanned.",
        "example": "stech-api.sheradogilang.workers.dev"
      },
      "path": {
        "type": "string",
        "title": "Path",
        "description": "Full path of the endpoint that was checked.",
        "example": "/x402/sapi"
      },
      "status": {
        "type": "string",
        "title": "Status",
        "description": "HTTP status code returned by the endpoint, or 'unknown' if not probed.",
        "example": "402"
      },
      "x402Version": {
        "type": "string",
        "title": "X402 Version",
        "description": "Version of the X402 protocol detected.",
        "example": "1"
      },
      "price": {
        "type": "string",
        "title": "Price (atomic units)",
        "description": "Raw price in atomic units of the payment token.",
        "example": "1000"
      },
      "priceReadable": {
        "type": "string",
        "title": "Price (USDC)",
        "description": "Price per call in USDC (e.g., $0.001000).",
        "example": "$0.001000"
      },
      "network": {
        "type": "string",
        "title": "Network",
        "description": "Blockchain network for payment.",
        "example": "base"
      },
      "asset": {
        "type": "string",
        "title": "Asset",
        "description": "Token contract address for payment.",
        "example": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
      },
      "payTo": {
        "type": "string",
        "title": "Pay To",
        "description": "Wallet address that receives the payment.",
        "example": "0xC33336EB299d97aa76E61337906A677552878818"
      },
      "label": {
        "type": "string",
        "title": "Label",
        "description": "Product label from the X402 offer.",
        "example": "Stech – Honest Presence API"
      },
      "description": {
        "type": "string",
        "title": "Description",
        "description": "Product description from the X402 offer.",
        "example": "Ethical AI assistant that provides honest, warm presence."
      },
      "source": {
        "type": "string",
        "title": "Source",
        "description": "Origin of the endpoint data (e.g., well-known-x402, llms.txt, scraper:402, dictionary, manual).",
        "example": "llms.txt"
      },
      "auditHash": {
        "type": "string",
        "title": "Audit Hash",
        "description": "SHA-256 hash of the raw response body for verifiable claims.",
        "example": "a1b2c3d4e5f6..."
      },
      "httpStatus": {
        "type": "string",
        "title": "HTTP Status",
        "description": "HTTP status code returned by the endpoint.",
        "example": "402"
      },
      "responseTimeMs": {
        "type": "string",
        "title": "Response Time (ms)",
        "description": "Response time in milliseconds.",
        "example": "118"
      },
      "errorMessage": {
        "type": "string",
        "title": "Error Message",
        "description": "Error message if the endpoint check failed.",
        "example": ""
      },
      "timestamp": {
        "type": "string",
        "title": "Timestamp",
        "description": "Scan timestamp in ISO 8601 format.",
        "example": "2026-05-24T11:36:03.293Z"
      },
      "download_docx": {
        "type": "string",
        "title": "Download DOCX",
        "description": "URL to download the full scan report as a Microsoft Word (.docx) file.",
        "example": "https://api.apify.com/v2/key-value-stores/STORE_ID/records/OUTPUT.docx"
      },
      "download_pdf": {
        "type": "string",
        "title": "Download PDF",
        "description": "URL to download the full scan report as a PDF file.",
        "example": "https://api.apify.com/v2/key-value-stores/STORE_ID/records/OUTPUT.pdf"
      }
    },
    "required": ["domain", "path", "status", "timestamp", "download_docx", "download_pdf", "priceReadable", "auditHash"]
  },
  "views": {
    "overview": {
      "title": "X402 Domain Scan Results",
      "transformation": {
        "fields": [
          "domain", "path", "status", "source", "x402Version", "price", "priceReadable",
          "network", "asset", "payTo", "label", "description", "auditHash",
          "httpStatus", "responseTimeMs", "errorMessage", "timestamp",
          "download_docx", "download_pdf"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "domain": { "label": "Domain", "format": "text" },
          "path": { "label": "Path", "format": "text" },
          "status": { "label": "Status", "format": "text" },
          "source": { "label": "Source", "format": "text" },
          "x402Version": { "label": "X402 Version", "format": "text" },
          "price": { "label": "Price (raw)", "format": "text" },
          "priceReadable": { "label": "Price (USDC)", "format": "text" },
          "network": { "label": "Network", "format": "text" },
          "asset": { "label": "Asset", "format": "text" },
          "payTo": { "label": "Pay To", "format": "text" },
          "label": { "label": "Label", "format": "text" },
          "description": { "label": "Description", "format": "text" },
          "auditHash": { "label": "Audit Hash", "format": "text" },
          "httpStatus": { "label": "HTTP Status", "format": "text" },
          "responseTimeMs": { "label": "Response Time (ms)", "format": "text" },
          "errorMessage": { "label": "Error Message", "format": "text" },
          "timestamp": { "label": "Timestamp", "format": "text" },
          "download_docx": { "label": "Download DOCX", "format": "text" },
          "download_pdf": { "label": "Download PDF", "format": "text" }
        }
      }
    }
  }
}
